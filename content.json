const state = {
  published: null,
  draft: null,
  isEditMode: false,
  undoStack: [],
  redoStack: []
};

const elements = {
  toolbar: document.getElementById('edit-toolbar'),
  saveStatus: document.getElementById('save-status'),
  accentPicker: document.getElementById('accent-picker'),
  defaultScheme: document.getElementById('default-scheme'),
  themeToggle: document.getElementById('theme-toggle'),
  ipFile: document.getElementById('import-file'),
  repoDialog: document.getElementById('repo-dialog'),
  repoInput: document.getElementById('repo-input'),
  visibilityDialog: document.getElementById('visibility-dialog'),
  visibilityOptions: document.getElementById('visibility-options'),
  footerYear: document.getElementById('footer-year')
};

function deepClone(value) {
  return JSON.parse(JSON.stringify(value));
}

function escapeText(value) {
  return String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[char]));
}

function normalizeContent(raw) {
  const base = deepClone(fallbackContent);
  if (!raw || typeof raw !== 'object') return base;
  return {
    hero: { ...base.hero, ...(raw.hero || {}) , cta: { ...base.hero.cta, ...(raw.hero && raw.hero.cta ? raw.hero.cta : {}) } },
    about: { ...base.about, ...(raw.about || {}) },
    projects: Array.isArray(raw.projects) ? raw.projects.map((project, index) => ({
      title: project?.title ?? `Project ${index + 1}`,
      description: project?.description ?? '',
      image: project?.image ?? '',
      link: project?.link ?? '#',
      tags: Array.isArray(project?.tags) ? project.tags : []
    })) : base.projects,
    skills: Array.isArray(raw.skills) ? raw.skills.map(String) : base.skills,
    experience: Array.isArray(raw.experience) ? raw.experience.map((item) => ({
      role: item?.role ?? 'Role',
      organisation: item?.organisation ?? 'Organisation',
      dates: item?.dates ?? 'Dates',
      description: item?.description ?? ''
    })) : base.experience,
    contact: {
      email: raw.contact?.email ?? base.contact.email,
      social: Array.isArray(raw.contact?.social) ? raw.contact.social.map((item) => ({
        label: item?.label ?? 'Link',
        url: item?.url ?? '#'
      })) : base.contact.social
    },
    meta: {
      accent: raw.meta?.accent ?? base.meta.accent,
      scheme: raw.meta?.scheme ?? base.meta.scheme,
      visible: { ...base.meta.visible, ...(raw.meta?.visible || {}) }
    }
  };
}

function markSaved(message = 'Saved locally') {
  elements.saveStatus.textContent = message;
}

function markUnsaved() {
  elements.saveStatus.textContent = 'Unsaved changes';
}

async function loadPublishedContent() {
  try {
    const response = await fetch('content.json', { cache: 'no-store' });
    if (!response.ok) throw new Error('Failed to load');
    const json = await response.json();
    const normalized = normalizeContent(json);
    state.published = normalized;
    return normalized;
  } catch (error) {
    console.warn('content.json could not be loaded; falling back to defaults.', error);
    state.published = deepClone(fallbackContent);
    return deepClone(fallbackContent);
  }
}

function loadDraft() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    return normalizeContent(parsed);
  } catch (error) {
    console.warn('Could not parse draft from localStorage.', error);
    return null;
  }
}

function persistDraft() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state.draft));
  markSaved('Saved locally');
}

function pushHistory() {
  const snapshot = JSON.stringify(state.draft);
  if (state.undoStack[state.undoStack.length - 1] === snapshot) return;
  state.undoStack.push(snapshot);
  if (state.undoStack.length > HISTORY_LIMIT) state.undoStack.shift();
  state.redoStack = [];
}

function undo() {
  if (!state.undoStack.length) return;
  const current = JSON.stringify(state.draft);
  state.redoStack.push(current);
  state.undoStack.pop();
  const previous = state.undoStack[state.undoStack.length - 1];
  if (!previous) {
    state.draft = deepClone(state.published);
  } else {
    state.draft = JSON.parse(previous);
  }
  render();
  markUnsaved();
}

function redo() {
  if (!state.redoStack.length) return;
  const current = JSON.stringify(state.draft);
  state.undoStack.push(current);
  const next = state.redoStack.pop();
  state.draft = JSON.parse(next);
  render();
  markUnsaved();
}

function applyThemeFromState() {
  const mode = state.draft.meta.scheme || 'auto';
  const root = document.documentElement;
  root.setAttribute('data-theme', 'dark');

  if (mode === 'light') {
    root.setAttribute('data-theme', 'light');
    return;
  }

  if (mode === 'dark') {
    root.setAttribute('data-theme', 'dark');
    return;
  }

  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
}

function setManualTheme(value) {
  const root = document.documentElement;
  if (value === 'light' || value === 'dark') {
    root.setAttribute('data-theme', value);
  } else {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
  }
}

function setupThemeToggle() {
  const mode = state.draft.meta.scheme || 'auto';
  const isDark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
  elements.themeToggle.textContent = isDark ? '🌙' : '☀️';

  elements.themeToggle.addEventListener('click', () => {
    const currentMode = state.draft.meta.scheme || 'auto';
    let next;

    if (currentMode === 'auto') {
      next = 'dark';
    } else if (currentMode === 'dark') {
      next = 'light';
    } else {
      next = 'auto';
    }

    state.draft.meta.scheme = next;
    localStorage.setItem('portfolio_theme_default', next);
    applyThemeFromState();
    elements.defaultScheme.value = next;
    markUnsaved();
    queueAutosave();
  });
}

function renderSectionVisibilityControls() {
  const visible = state.draft.meta.visible || {};
  const sectionNames = [
    { key: 'hero', label: 'Hero' },
    { key: 'about', label: 'About' },
    { key: 'projects', label: 'Projects' },
    { key: 'skills', label: 'Skills' },
    { key: 'experience', label: 'Experience' },
    { key: 'contact', label: 'Contact' }
  ];

  elements.visibilityOptions.innerHTML = '';
  sectionNames.forEach(({ key, label }) => {
    const row = document.createElement('label');
    row.className = 'visibility-option';

    const name = document.createElement('span');
    name.textContent = label;

    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.checked = visible[key] !== false;
    checkbox.addEventListener('change', () => {
      state.draft.meta.visible[key] = checkbox.checked;
      render();
      markUnsaved();
      queueAutosave();
    });

    row.append(name, checkbox);
    elements.visibilityOptions.appendChild(row);
  });
}

function render() {
  const draft = state.draft;
  if (!draft) return;

  document.documentElement.style.setProperty('--accent', draft.meta.accent || '#0b7cff');
  elements.accentPicker.value = draft.meta.accent || '#0b7cff';
  elements.defaultScheme.value = draft.meta.scheme || 'auto';
  applyThemeFromState();

  const visible = draft.meta.visible || {};
  ['hero', 'about', 'projects', 'skills', 'experience', 'contact'].forEach((sectionId) => {
    const section = document.getElementById(sectionId);
    if (!section) return;
    section.classList.toggle('hidden', visible[sectionId] === false);
  });

  const heroName = document.getElementById('hero-name');
  heroName.textContent = draft.hero.name || '';

  const heroTitle = document.getElementById('hero-title');
  heroTitle.textContent = draft.hero.title || '';

  const heroIntro = document.getElementById('hero-intro');
  heroIntro.textContent = draft.hero.intro || '';

  const heroCta = document.getElementById('hero-cta');
  heroCta.textContent = draft.hero.cta?.text || 'Get in touch';
  heroCta.href = draft.hero.cta?.link || '#contact';

  const profileImage = document.getElementById('profile-image');
  profileImage.src = draft.hero.image || '';
  profileImage.alt = `${draft.hero.name || 'Profile'} portrait`;

  const aboutText = document.getElementById('about-text');
  aboutText.textContent = draft.about.text || '';

  renderProjects();
  renderSkills();
  renderExperience();
  renderContact();

  elements.footerYear.textContent = new Date().getFullYear();
  renderSectionVisibilityControls();
  updateEditState();
}

function renderProjects() {
  const list = document.getElementById('projects-list');
  list.innerHTML = '';

  draftForEach('projects', (project, index) => {
    const card = document.createElement('article');
    card.className = 'project-card';
    card.dataset.index = String(index);

    const image = document.createElement('img');
    image.src = project.image || '';
    image.alt = `${project.title || 'Project'} illustration`;
    image.dataset.imageTarget = `projects.${index}.image`;
    if (state.isEditMode) image.classList.add('editable-image');

    const title = document.createElement('h3');
    title.textContent = project.title || 'Untitled project';
    title.setAttribute('data-list-field', `projects.${index}.title`);

    const desc = document.createElement('p');
    desc.textContent = project.description || '';
    desc.setAttribute('data-list-field', `projects.${index}.description`);

    const tags = document.createElement('div');
    tags.className = 'tag-list';
    (project.tags || []).forEach((tag) => {
      const span = document.createElement('span');
      span.className = 'skill-tag';
      span.textContent = tag;
      tags.appendChild(span);
    });

    const link = document.createElement('a');
    link.href = safeUrl(project.link || '#');
    link.target = '_blank';
    link.rel = 'noreferrer';
    link.textContent = 'View project';
    link.className = 'button-secondary';

    const controls = document.createElement('div');
    controls.className = 'list-controls';

    if (state.isEditMode) {
      const up = createMiniButton('↑', () => moveItem('projects', index, -1));
      const down = createMiniButton('↓', () => moveItem('projects', index, 1));
      const del = createMiniButton('Delete', () => deleteItem('projects', index));
      controls.append(up, down, del);
    }

    card.append(image, title, desc, tags, link, controls);
    list.appendChild(card);
  });
}

function renderSkills() {
  const list = document.getElementById('skills-list');
  list.innerHTML = '';

  draftForEach('skills', (skill, index) => {
    const tag = document.createElement('span');
    tag.className = 'skill-tag';
    tag.textContent = skill || ''; 
    tag.dataset.index = String(index);
    tag.setAttribute('data-list-field', `skills.${index}`);

    const controls = document.createElement('div');
    controls.className = 'inline-controls';
    if (state.isEditMode) {
      const up = createMiniButton('↑', () => moveItem('skills', index, -1));
      const down = createMiniButton('↓', () => moveItem('skills', index, 1));
      const del = createMiniButton('Delete', () => deleteItem('skills', index));
      controls.append(up, down, del);
      tag.appendChild(controls);
    }

    list.appendChild(tag);
  });
}

function renderExperience() {
